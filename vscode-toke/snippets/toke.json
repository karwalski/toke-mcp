{
  "Module declaration": {
    "prefix": "mod",
    "body": [
      "M=${1:name};"
    ],
    "description": "Declare a module"
  },
  "Function declaration": {
    "prefix": "fn",
    "body": [
      "F=${1:name}(${2:params}):${3:ret}{",
      "\t$0",
      "}"
    ],
    "description": "Declare a function"
  },
  "Type declaration": {
    "prefix": "st",
    "body": [
      "T=${1:Name}{",
      "\t${2:field}:${3:type}",
      "}"
    ],
    "description": "Declare a struct type"
  },
  "Import": {
    "prefix": "imp",
    "body": [
      "I=${1:alias}:${2:path};"
    ],
    "description": "Import a module"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "lp(${1:init};${2:cond};${3:step}){",
      "\t$0",
      "}"
    ],
    "description": "Loop statement"
  },
  "If-else": {
    "prefix": "ifelse",
    "body": [
      "if(${1:cond}){",
      "\t${2:then}",
      "}el{",
      "\t${3:else}",
      "}"
    ],
    "description": "If-else block"
  },
  "Let binding": {
    "prefix": "let",
    "body": [
      "let ${1:name}=${2:value};"
    ],
    "description": "Immutable let binding"
  },
  "Let mutable binding": {
    "prefix": "letmut",
    "body": [
      "let ${1:name}=mut.${2:value};"
    ],
    "description": "Mutable let binding"
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "M=${1:main};",
      "",
      "F=main():i64{",
      "\t$0",
      "\t0",
      "}"
    ],
    "description": "Main function template"
  }
}
