{
  "name": "toke-language",
  "displayName": "Toke - Token-Optimised Language",
  "description": "Syntax highlighting, diagnostics, and code intelligence for the Toke programming language",
  "version": "0.2.2",
  "publisher": "tokelang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/karwalski/toke-mcp.git",
    "directory": "vscode-toke"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "icon": "images/toke-icon.png",
  "activationEvents": [
    "onLanguage:toke",
    "onCommand:toke.openCompanion"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "toke",
        "aliases": [
          "Toke",
          "toke"
        ],
        "extensions": [
          ".tk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "toke",
        "scopeName": "source.toke",
        "path": "./syntaxes/toke.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "toke",
        "path": "./snippets/toke.json"
      }
    ],
    "commands": [
      {
        "command": "toke.openCompanion",
        "title": "Toke: Open Companion File",
        "enablement": "editorLangId == toke"
      }
    ],
    "configuration": {
      "title": "Toke",
      "properties": {
        "toke.lsp.path": {
          "type": "string",
          "default": "toke-lsp",
          "description": "Path to the toke-lsp language server binary"
        },
        "toke.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Toke language server for diagnostics and code intelligence"
        },
        "toke.companion.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open companion files (.tkc.md, .tkc.yaml, .tkc.json) side-by-side when opening a .tk file"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
