{
  "name": "@tokelang/mcp-server",
  "version": "0.1.1",
  "description": "Self-hostable MCP server for the toke programming language. toke: a compiled language designed for LLM code generation, with a small grammar, one canonical form and compiler verification.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "toke-mcp": "./bin/toke-mcp.js"
  },
  "files": [
    "server.js",
    "tools/",
    "lib/",
    "skills/",
    "bin/"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:compat",
    "test:unit": "node --test test/test_*.js",
    "test:compat": "bash test/compatibility/run_compat.sh",
    "prepublishOnly": "node bin/toke-mcp.js --help"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0"
  },
  "optionalDependencies": {
    "ioredis": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "toke",
    "mcp",
    "language-server",
    "compiler",
    "code-generation",
    "llm",
    "token-efficiency",
    "programming-language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/karwalski/toke-mcp.git"
  },
  "homepage": "https://tokelang.dev",
  "bugs": {
    "url": "https://github.com/karwalski/toke-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
